# Copy to .env. docker-compose overrides the database, broker and MLflow URLs.
DATABASE_URL=sqlite:///data.db
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
MLFLOW_TRACKING_URI=http://localhost:5001

# Recommended: raises the GitHub API limit from 60 to 5,000 requests/hour
GITHUB_TOKEN=

# Optional: require an X-API-Key header on every request except / and /metrics
API_KEY=

# Optional: Arize monitoring (set ARIZE_ENABLED=true and fill in both keys)
ARIZE_ENABLED=false
ARIZE_API_KEY=
ARIZE_SPACE_KEY=

# Optional: local LLM for GET /predictions/<id>/explainer
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT=180

# Optional: host ports for docker compose (change any that are already in use;
# on macOS, AirPlay Receiver often holds 5000)
API_PORT=5000
MLFLOW_PORT=5001
POSTGRES_PORT=5432
REDIS_PORT=6379
